# Environment — actual credentials (DO NOT COMMIT)
.env

# Composer dependencies (vendor directory only — lock file is committed for reproducible builds)
/vendor/

# Build output (regenerate with: npm run build)
/assets/dist/

# Node modules
/node_modules/

# OS files
Thumbs.db
.DS_Store

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Log files — keep the logs/ directory itself (via .gitkeep) so the app can
# write to it, but ignore everything written into it.
/logs/*
!/logs/.gitkeep
*.log

# Test results
/test-results/

# PHPUnit cache
/.phpunit.cache/
